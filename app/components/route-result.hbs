<div class="route-result">
    {{#if this.distanceText}}
        <p class="route-result__summary">
            Відстань:
            <strong>{{this.distanceText}}</strong>
            {{#if this.durationText}}
                · Час:
                <strong>{{this.durationText}}</strong>
            {{/if}}
        </p>
    {{/if}}

    {{#if @route.phoneLookupWarning}}
        <p class="route-result__warning" role="status">
            Маршрут побудовано, але телефони не завантажено:
            {{@route.phoneLookupWarning}}
        </p>
    {{/if}}

    {{#each this.routeParts as |part|}}
        <div class="route-result__part">
            <ol class="route-result__stops">
                {{#each part.stops as |stop index|}}
                    <li class="route-result__stop">
                        <span class="route-result__stop-address">
                            {{#if stop.mapUrl}}
                                <a href={{stop.mapUrl}} target="_blank" rel="noopener noreferrer">{{add index 1}}.
                                    {{stop.address}}</a>
                            {{else}}
                                <strong>{{add index 1}}. {{stop.address}}</strong>
                            {{/if}}
                        </span>
                        {{#if stop.phone}}
                            <a
                                class="route-result__phone"
                                href={{stop.phone.href}}
                                aria-label={{concat "Зателефонувати " stop.phone.number}}
                                title={{stop.phone.number}}
                            >
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path
                                        d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.36 2.3.54 3.6.54a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.18 2.45.54 3.57a1 1 0 0 1-.25 1.02L6.6 10.8Z"
                                    />
                                </svg>
                            </a>
                        {{/if}}
                        {{#if stop.blacklisted}}
                            {{#let (address-details stop.blacklistReason) as |details|}}
                                {{#if details.isPension}}
                                    <span
                                        class="address-details__icon address-details__icon-pension"
                                        role="img"
                                        aria-label="Адреса в чорному списку"
                                        title="Адреса в чорному списку"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 640 640"
                                        ><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path
                                                d="M128 128C92.7 128 64 156.7 64 192L64 448C64 483.3 92.7 512 128 512L512 512C547.3 512 576 483.3 576 448L576 192C576 156.7 547.3 128 512 128L128 128zM360 352L488 352C501.3 352 512 362.7 512 376C512 389.3 501.3 400 488 400L360 400C346.7 400 336 389.3 336 376C336 362.7 346.7 352 360 352zM336 264C336 250.7 346.7 240 360 240L488 240C501.3 240 512 250.7 512 264C512 277.3 501.3 288 488 288L360 288C346.7 288 336 277.3 336 264zM212 208C223 208 232 217 232 228L232 232L240 232C251 232 260 241 260 252C260 263 251 272 240 272L192.5 272C185.6 272 180 277.6 180 284.5C180 290.6 184.4 295.8 190.4 296.8L232.1 303.8C257.4 308 276 329.9 276 355.6C276 381.7 257 403.3 232 407.4L232 412.1C232 423.1 223 432.1 212 432.1C201 432.1 192 423.1 192 412.1L192 408.1L168 408.1C157 408.1 148 399.1 148 388.1C148 377.1 157 368.1 168 368.1L223.5 368.1C230.4 368.1 236 362.5 236 355.6C236 349.5 231.6 344.3 225.6 343.3L183.9 336.3C158.5 332 140 310.1 140 284.5C140 255.7 163.2 232.3 192 232L192 228C192 217 201 208 212 208z"
                                            /></svg>
                                        {{details.pensionDay}}
                                    </span>
                                {{/if}}
                                {{#if details.hasMagazine}}
                                    <span
                                        class="address-details__icon address-details__icon-magazine"
                                        role="img"
                                        aria-label="Адреса в чорному списку"
                                        title="Адреса в чорному списку"
                                    >
                                        <svg
                                            version="1.0"
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="728.000000pt"
                                            height="734.000000pt"
                                            viewBox="0 0 728.000000 734.000000"
                                            preserveAspectRatio="xMidYMid meet"
                                        >

                                            <g
                                                transform="translate(0.000000,734.000000) scale(0.100000,-0.100000)"
                                                fill="currentColor"
                                                stroke="none"
                                            >
                                                <path
                                                    d="M1825 6256 c-84 -21 -147 -57 -211 -121 -68 -67 -106 -139 -123 -230
-9 -44 -11 -533 -9 -1802 l3 -1741 63 38 c204 123 490 133 699 26 38 -20 83
-45 101 -57 l32 -21 0 1756 c0 1252 -3 1770 -11 1808 -18 86 -58 158 -123 224
-114 113 -270 158 -421 120z"
                                                />
                                                <path
                                                    d="M2635 6053 c33 -84 34 -136 35 -2220 l0 -2053 1535 0 c1519 0 1536 0
1575 20 26 13 47 34 60 60 20 39 20 54 20 2065 0 2011 0 2026 -20 2065 -13 26
