-75 2 -110 -1 -158 -17z"
                                                />
                                            </g>
                                        </svg>
                                    </span>
                                {{/if}}
                                {{#if details.pensionNote}}
                                    <p class="address-details address-details__pension">
                                        {{details.pensionNote}}
                                    </p>
                                {{/if}}
                                {{#if details.isBlacklist}}
                                    <span
                                        class="address-details__icon address-details__icon-blacklist"
                                        role="img"
                                        aria-label="Адреса в чорному списку"
                                        title="Адреса в чорному списку"
                                    >
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 2 1 21h22L12 2Zm1 16h-2v-2h2v2Zm0-4h-2V9h2v5Z" />
                                        </svg>
                                    </span>
                                    {{#if details.blacklistNote}}
                                        <p class="address-details address-details__blacklist">
                                            {{details.blacklistNote}}
                                        </p>
                                    {{/if}}
                                {{/if}}
                            {{/let}}
                        {{/if}}
                    </li>
                {{/each}}
            </ol>

            <div class="route-result__maps-links">
                <a
                    class="route-result__maps-link"
                    href={{part.appleMapsUrl}}
                    target="_blank"
                    rel="noopener noreferrer"
                >Відкрити в Apple Maps
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        fill="currentColor"
                        class="bi bi-arrow-up-right-square"
                        viewBox="0 0 16 16"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M15 2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1zM0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm5.854 8.803a.5.5 0 1 1-.708-.707L9.243 6H6.475a.5.5 0 1 1 0-1h3.975a.5.5 0 0 1 .5.5v3.975a.5.5 0 1 1-1 0V6.707z"
                        />
                    </svg></a>

                <a
                    class="route-result__maps-link"
                    href={{part.googleMapsUrl}}
                    target="_blank"
                    rel="noopener noreferrer"
                >Відкрити у Google Maps
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        fill="currentColor"
                        class="bi bi-arrow-up-right-square"
                        viewBox="0 0 16 16"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M15 2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1zM0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm5.854 8.803a.5.5 0 1 1-.708-.707L9.243 6H6.475a.5.5 0 1 1 0-1h3.975a.5.5 0 0 1 .5.5v3.975a.5.5 0 1 1-1 0V6.707z"
                        />
                    </svg></a>
            </div>
        </div>
    {{/each}}

    {{#if @record}}
        <div
            class="route-result__actions {{if (or this.isNaming this.isDeleting) 'route-result__actions--full-width'}}"
        >
            {{#if (not this.isDeleting)}}
                {{#if @record.bookmarked}}
                    <span class="route-result__actions-button--green">Збережено
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            fill="currentColor"
                            class="bi bi-bookmark-check"
                            viewBox="0 0 16 16"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0"
                            />
                            <path
                                d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5zm2-1a1 1 0 0 0-1 1v12.566l4.723-2.482a.5.5 0 0 1 .554 0L13 14.566V2a1 1 0 0 0-1-1z"
                            />
                        </svg></span>
                {{else}}
                    {{#if this.isNaming}}
                        <form class="route-result__bookmark-form" {{on "submit" this.saveBookmark}}>
                            <div class="route-result__bookmark-header">
                                <label for="bookmark-name-{{@record.id}}" style="margin-bottom: 0;">Назва маршруту</label>
                                <button
                                    class="route-result__actions-button route-result__actions-button--green"
                                    type="submit"
                                >
                                    Зберегти
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="16"
                                        height="16"
                                        fill="currentColor"
                                        class="bi bi-bookmark-check"
                                        viewBox="0 0 16 16"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0"
                                        />
                                        <path
                                            d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5zm2-1a1 1 0 0 0-1 1v12.566l4.723-2.482a.5.5 0 0 1 .554 0L13 14.566V2a1 1 0 0 0-1-1z"
                                        />
                                    </svg>
                                </button>
                            </div>
                            <input
                                id="bookmark-name-{{@record.id}}"
                                type="text"
                                value={{this.bookmarkName}}
                                required
                                {{on "input" this.updateBookmarkName}}
                            />
                        </form>
                    {{else}}
                        <button
                            type="button"
                            class="route-result__actions-button route-result__actions-button--green"
                            {{on "click" this.openNaming}}
                        >
                            Зберегти
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                fill="currentColor"
                                class="bi bi-bookmark"
                                viewBox="0 0 16 16"
                            >
                                <path
                                    d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5zm2-1a1 1 0 0 0-1 1v12.566l4.723-2.482a.5.5 0 0 1 .554 0L13 14.566V2a1 1 0 0 0-1-1z"
                                />
                            </svg>
                        </button>
                    {{/if}}
                {{/if}}

            {{/if}}

            {{#unless this.isNaming}}
                {{#if @onDelete}}
                    {{#if this.isDeleting}}
                        <button
                            type="button"
                            class="route-result__actions-button route-result__delete"
                            {{on "click" this.deleteRoute}}
                        >
                            Підтвердження: Видалити маршрут
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                fill="currentColor"
                                class="bi bi-x-square"
                                viewBox="0 0 16 16"
                            >
                                <path
                                    d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"
                                />
                                <path
                                    d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"
                                />
                            </svg>
                        </button>
                    {{else}}
                        <button
                            type="button"
                            class="route-result__actions-button route-result__delete"
                            {{on "click" this.startDeleteRoute}}
                        >
                            Видалити
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                fill="currentColor"
                                class="bi bi-x-square"
                                viewBox="0 0 16 16"
                            >
                                <path
                                    d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"
                                />
                                <path
                                    d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"
                                />
                            </svg>
                        </button>
                    {{/if}}
                {{/if}}

                {{#if (and @onEdit (not this.isDeleting))}}
                    <button
                        type="button"
                        class="route-history__toggle"
                        {{on "click" this.copyAddressTextToClipboard}}
                    >Скопіювати
                        <span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                fill="currentColor"
                                class="bi bi-copy"
                                viewBox="0 0 16 16"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M4 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM2 5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1v1z"
                                />
                            </svg>
                        </span>
                    </button>
                    <button type="button" class="route-history__toggle" {{on "click" @onEdit}}>Редагувати
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            fill="currentColor"
                            class="bi bi-pencil-square"
                            viewBox="0 0 16 16"
                        >
                            <path
                                d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"
                            />
                            <path
                                fill-rule="evenodd"
                                d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"
                            />
                        </svg>
                    </button>
                {{/if}}
            {{/unless}}
            {{#if this.actionError}}<p role="alert">{{this.actionError}}</p>{{/if}}
        </div>
    {{/if}}
</div>