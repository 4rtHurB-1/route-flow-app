                                                />
                                                <path
                                                    d="M3370 4570 l0 -600 870 0 870 0 0 600 0 600 -870 0 -870 0 0 -600z"
                                                />
                                                <path
                                                    d="M1783 2180 c-126 -41 -239 -157 -282 -288 -25 -74 -26 -131 -6 -227
38 -184 176 -361 345 -444 154 -75 44 -71 1788 -71 1547 0 1563 0 1602 20 62
