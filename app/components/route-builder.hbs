<section class="route-builder" aria-busy={{this.isLoading}}>
    <form class="route-builder__form" {{on "submit" this.buildRoute}}>
        <div class="route-builder__header">
            <label class="route-builder__label" for="route-addresses">
                Адреси
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    fill="currentColor"
                    class="bi bi-building-fill-add"
                    viewBox="0 0 16 16"
                >
                    <path
                        d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m.5-5v1h1a.5.5 0 0 1 0 1h-1v1a.5.5 0 0 1-1 0v-1h-1a.5.5 0 0 1 0-1h1v-1a.5.5 0 0 1 1 0"
                    />
                    <path
                        d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7.256A4.5 4.5 0 0 0 12.5 8a4.5 4.5 0 0 0-3.59 1.787A.5.5 0 0 0 9 9.5v-1a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .39-.187A4.5 4.5 0 0 0 8.027 12H6.5a.5.5 0 0 0-.5.5V16H3a1 1 0 0 1-1-1zm2 1.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5m3 0v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5m3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zM4 5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5M7.5 5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zm2.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5M4.5 8a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5z"
                    />
                </svg>
            </label>

            <LinkTo class="route-builder__history-link" @route="history">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    fill="currentColor"
                    class="bi bi-clock-history"
                    viewBox="0 0 16 16"
                >
                    <path
                        d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022zm2.004.45a7 7 0 0 0-.985-.299l.219-.976q.576.129 1.126.342zm1.37.71a7 7 0 0 0-.439-.27l.493-.87a8 8 0 0 1 .979.654l-.615.789a7 7 0 0 0-.418-.302zm1.834 1.79a7 7 0 0 0-.653-.796l.724-.69q.406.429.747.91zm.744 1.352a7 7 0 0 0-.214-.468l.893-.45a8 8 0 0 1 .45 1.088l-.95.313a7 7 0 0 0-.179-.483m.53 2.507a7 7 0 0 0-.1-1.025l.985-.17q.1.58.116 1.17zm-.131 1.538q.05-.254.081-.51l.993.123a8 8 0 0 1-.23 1.155l-.964-.267q.069-.247.12-.501m-.952 2.379q.276-.436.486-.908l.914.405q-.24.54-.555 1.038zm-.964 1.205q.183-.183.35-.378l.758.653a8 8 0 0 1-.401.432z"
                    />
                    <path d="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0z" />
                    <path
                        d="M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5"
                    />
                </svg>
                Історія маршрутів
            </LinkTo>
        </div>

        <textarea
            id="route-addresses"
            class="route-builder__textarea"
            rows="9"
            value={{this.addresses}}
            placeholder="Супутника 17&#10;Гаївська 14&#10;Княгині Ольги 14"
            {{on "input" this.updateAddresses}}
        ></textarea>

        {{#unless this.pendingMissing}}
            <button class="route-builder__button" type="submit" disabled={{this.isSubmitDisabled}}>
                {{#if this.isLoading}}
                    Будую маршрут…
                {{else}}
                    Побудувати маршрут
                {{/if}}
            </button>
        {{/unless}}
    </form>

    {{#if this.errorMessage}}
        <p class="route-builder__error" role="alert">
            {{this.errorMessage}}
        </p>
    {{/if}}

    {{#if this.pendingMissing}}
        <div class="route-builder__missing">
            {{#each this.missingItems as |item|}}
                <NotFoundAddress @item={{item}} @onChange={{this.chooseResolution}} />
            {{/each}}
            <button
                class="route-builder__button mb-2"
                type="button"
                disabled={{this.isLoading}}
                {{on "click" this.continueBuild}}
            >
                {{#if this.isLoading}}
                    Будую маршрут…
                {{else}}
                    Продовжити будувати маршрут
                {{/if}}
            </button>
        </div>
    {{/if}}

    {{#if this.result}}
        <RouteResult @route={{this.result}} @record={{this.resultRecord}} @onBookmark={{this.bookmarkRoute}} />
    {{/if}}
</section>