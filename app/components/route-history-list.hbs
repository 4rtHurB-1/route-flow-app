<section class="route-history">
    <header class="route-history__header">

        {{! <h3>Історія маршрутів</h3> }}

        <LinkTo @route="index" class="pb-3 font-weight-bold" style="color: #0d5fc7;">Назад до побудови маршруту</LinkTo>
        <p class="mb-0">Збережені маршрути й останні 10 маршрутів</p>
    </header>

    {{#if this.items.length}}
        <div class="route-history__list">
            {{#each this.items as |item|}}
                <article class="route-history__item">
                    <h2 class="route-history__title">
                        {{#if item.bookmarked}}★ {{/if}}{{item.displayTitle}}
                    </h2>
                    <div class="route-history__toggle {{if item.isOpen 'route-history__toggle--open'}}">
                        {{#if item.isOpen}}
                            <div class="route-history__toggle-btn">
                                <a role="button" {{on "click" (fn this.toggleRoute item.id)}}>Сховати маршрут</a>
                                <a role="button" {{on "click" (fn this.copyAddressTextToClipboard item)}}>Скопіювати
                                    <span>
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            fill="currentColor"
                                            class="bi bi-copy"
                                            viewBox="0 0 16 16"
                                        >
                                            <path
                                                fill-rule="evenodd"
                                                d="M4 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM2 5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1v1z"
                                            />
                                        </svg>
                                    </span></a>
                            </div>

                        {{else}}
                            <a role="button" {{on "click" (fn this.toggleRoute item.id)}}>Подивитися маршрут</a>
                        {{/if}}
                    </div>

                    {{#if item.isOpen}}
                        <RouteResult
                            @route={{item.route}}
                            @record={{item}}
                            @onBookmark={{this.bookmarkRoute}}
                            @onDelete={{this.deleteRoute}}
                        />
                    {{/if}}
                </article>
            {{/each}}
        </div>
    {{else}}
        <p class="route-history__empty">Історія маршрутів поки порожня</p>
    {{/if}}
</section>