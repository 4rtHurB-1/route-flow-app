<section class="route-history">
    <header class="route-history__header">

        {{! <h3>Історія маршрутів</h3> }}

        <LinkTo @route="index" class="pb-3 font-weight-bold" style="display: flex;align-items: center;color: #0d5fc7;">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-chevron-left"
                viewBox="0 0 16 16"
            >
                <path
                    fill-rule="evenodd"
                    d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"
                />
            </svg>
            Назад до побудови маршруту</LinkTo>
        <p class="mb-0">Збережені маршрути й останні 10 маршрутів</p>
    </header>

    {{#if this.items.length}}
        <div class="route-history__list">
            {{#each this.items as |item|}}
                <article class="route-history__item">
                    <h2 class="route-history__title">
                        {{#if item.bookmarked}}<svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                fill="currentColor"
                                class="bi bi-bookmark-fill"
                                viewBox="0 0 16 16"
                            >
                                <path
                                    d="M2 2v13.5a.5.5 0 0 0 .74.439L8 13.069l5.26 2.87A.5.5 0 0 0 14 15.5V2a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2"
                                />
                            </svg>
                        {{/if}}{{item.displayTitle}}
                    </h2>
                    <div class="route-history__toggle {{if item.isOpen 'route-history__toggle--open'}}">
                        {{#if item.isOpen}}
                            <div class="route-history__toggle-btn">
                                <a role="button" {{on "click" (fn this.toggleRoute item.id)}}>Сховати маршрут
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="16"
                                        height="16"
                                        fill="currentColor"
                                        class="bi bi-chevron-up"
                                        viewBox="0 0 16 16"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M7.646 4.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1-.708.708L8 5.707l-5.646 5.647a.5.5 0 0 1-.708-.708z"
                                        />
                                    </svg>
                                </a>
                            </div>

                        {{else}}
                            <a role="button" {{on "click" (fn this.toggleRoute item.id)}}>Подивитися маршрут
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="16"
                                    height="16"
                                    fill="currentColor"
                                    class="bi bi-chevron-down"
                                    viewBox="0 0 16 16"
                                >
                                    <path
                                        fill-rule="evenodd"
                                        d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"
                                    />
                                </svg>
                            </a>
                        {{/if}}
                    </div>

                    {{#if item.isOpen}}
                        {{#if this.isEditRoute}}
                            <RouteHistoryEditor @record={{item}} @onEndEdit={{this.endEditRoute}} />
                        {{else}}
                            {{!-- <div class="route-history__actions">
                                <button
                                    type="button"
                                    class="route-history__toggle"
                                    {{on "click" this.startEditRoute}}
                                >Редагувати маршрут
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="16"
                                        height="16"
                                        fill="currentColor"
                                        class="bi bi-pencil-square"
                                        viewBox="0 0 16 16"
                                    >
                                        <path
                                            d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"
                                        />
                                        <path
                                            fill-rule="evenodd"
                                            d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"
                                        />
                                    </svg>
                                </button>
                            </div> --}}
                            <RouteResult
                                @route={{item.route}}
                                @record={{item}}
                                @onBookmark={{this.bookmarkRoute}}
                                @onDelete={{this.deleteRoute}}
                                @onEdit={{this.startEditRoute}}
                            />
                        {{/if}}
                    {{/if}}
                </article>
            {{/each}}
        </div>
    {{else}}
        <p class="route-history__empty">Історія маршрутів поки порожня</p>
    {{/if}}
</section>