<section class="route-history-editor" aria-busy={{this.isLoading}}>
    <form {{on "submit" this.updateRoute}}>
        <label for="history-addresses-{{@record.id}}" style="font-weight: bold;">Редагування адрес маршруту
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-building-fill-add"
                viewBox="0 0 16 16"
            >
                <path
                    d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m.5-5v1h1a.5.5 0 0 1 0 1h-1v1a.5.5 0 0 1-1 0v-1h-1a.5.5 0 0 1 0-1h1v-1a.5.5 0 0 1 1 0"
                />
                <path
                    d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7.256A4.5 4.5 0 0 0 12.5 8a4.5 4.5 0 0 0-3.59 1.787A.5.5 0 0 0 9 9.5v-1a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .39-.187A4.5 4.5 0 0 0 8.027 12H6.5a.5.5 0 0 0-.5.5V16H3a1 1 0 0 1-1-1zm2 1.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5m3 0v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5m3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zM4 5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5M7.5 5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zm2.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5M4.5 8a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5z"
                />
            </svg>
        </label>
        <textarea
            id="history-addresses-{{@record.id}}"
            class="route-builder__textarea"
            rows="9"
            value={{this.addresses}}
            {{on "input" this.changeAddresses}}
        ></textarea>
        {{#if this.pendingMissing}}
            {{#each this.missingItems as |item|}}
                <NotFoundAddress @item={{item}} @onChange={{this.chooseResolution}} />
            {{/each}}
        {{/if}}
        <div class="route-history-editor__actions">
            <button type="submit" disabled={{this.isLoading}} class="route-builder__button" style="padding: 0.5rem 1.1rem">
                {{#if this.isLoading}}Оновлюю маршрут…{{else}}Оновити маршрут{{/if}}
            </button>
            {{#unless this.isLoading}}
                <button
                    type="button"
                    class="route-history__toggle route-result__delete"
                    {{on "click" this.cancelEditing}}
                >Скасувати</button>
            {{/unless}}
        </div>
    </form>
    {{#if this.errorMessage}}
        <p class="route-builder__error" role="alert">{{this.errorMessage}}</p>
    {{/if}}
</section>